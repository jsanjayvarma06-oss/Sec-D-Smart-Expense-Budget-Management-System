{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"test/**/*.test.js\"",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.js",
    "db:restore": "node --env-file-if-exists=.env scripts/restore.js",
    "db:crash-drill": "node --env-file-if-exists=.env scripts/forcedShutdownDrill.js",
    "mail:latest": "node --env-file-if-exists=.env scripts/latestEmail.js",
    "test:plan": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"test/plan/*.test.js\"; node scripts/renderTestResults.js",
    "load:seed": "node scripts/load/seed.js",
    "load:run": "node scripts/load/run.js",
    "admin:create": "node --env-file-if-exists=.env scripts/createAdmin.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  }
}
